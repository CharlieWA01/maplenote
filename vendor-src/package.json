{
  "name": "maplenote-vendor",
  "private": true,
  "description": "Recipe for static/vendor/codemirror.js. Only needed when upgrading CodeMirror; running Maplenote doesn't need Node.",
  "scripts": {
    "build": "esbuild codemirror-entry.js --bundle --minify --format=iife --global-name=CM --legal-comments=inline --outfile=../static/vendor/codemirror.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
